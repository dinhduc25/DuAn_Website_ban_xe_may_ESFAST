// ============================================================================
// ESFAST E-COMMERCE - DBML (Database Markup Language)
// Dung cho dbdiagram.io de sinh ERD va ma SQL (MySQL/PostgreSQL)
// Nguon: assets/js/storage.js + README.md
// ============================================================================

// ---------- ENUMS ----------
Enum user_role {
  admin
  shop_manager
  customer
}

Enum user_status {
  active
  locked
}

Enum voucher_type {
  percentage
  fixed
}

Enum payment_method {
  cod
  bank_transfer
  online_gateway
}

Enum payment_status {
  unpaid
  paid
}

Enum order_status {
  processing
  shipping
  completed
  cancelled
}

Enum payment_tx_status {
  pending
  success
  failed
}

Enum tdr_status {
  pending
  contacted
  completed
}

// ---------- 1. USERS ----------
Table users {
  id bigint [pk, increment]
  username varchar(50) [unique, not null]
  email varchar(100) [unique, not null]
  password varchar(255) [not null, note: 'Luu hash (bcrypt) trong he thong that']
  full_name varchar(100) [not null]
  phone varchar(20)
  address text
  role user_role [not null, default: 'customer']
  status user_status [not null, default: 'active']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    role
    status
  }
}

// ---------- 2. CATEGORIES ----------
Table categories {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
  description text
  icon varchar(50) [note: 'FontAwesome class, vd: fa-bolt']
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

// ---------- 3. BRANDS ----------
Table brands {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
  description text
  is_active boolean [not null, default: true]
}

// ---------- 4. PRODUCTS ----------
Table products {
  id int [pk, increment]
  sku varchar(50) [unique, not null]
  name varchar(150) [not null]
  slug varchar(150) [unique, not null]
  category_id int [not null, ref: > categories.id]
  brand_id int [not null, ref: > brands.id]
  price decimal(15,2) [not null, note: 'Gia goc']
  sale_price decimal(15,2) [note: 'Gia khuyen mai']
  image varchar(255) [note: 'Anh dai dien']
  description text
  content text
  stock_quantity int [not null, default: 0]
  is_active boolean [not null, default: true]
  is_featured boolean [not null, default: false]
  is_new boolean [not null, default: false]
  is_bestseller boolean [not null, default: false]
  view_count int [not null, default: 0]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    category_id
    brand_id
    is_active
  }
}

// ---------- 5. PRODUCT_IMAGES ----------
Table product_images {
  id int [pk, increment]
  product_id int [not null, ref: > products.id]
  image_url varchar(255) [not null]
  sort_order int [not null, default: 0]

  Indexes {
    product_id
  }
}

// ---------- 6. PRODUCT_SPECS (1:1) ----------
Table product_specs {
  product_id int [pk, ref: - products.id]
  max_speed int [note: 'km/h']
  max_distance int [note: 'km / 1 lan sac']
  motor_power varchar(20) [note: 'vd: 7100W']
  battery_type varchar(100)
  battery_capacity varchar(50) [note: 'vd: 3.5 kWh']
  charging_time varchar(50) [note: 'vd: 6 gio']
  weight varchar(50) [note: 'vd: 145 kg']
  waterproof varchar(100) [note: 'vd: IP67']
  trunk_capacity varchar(50) [note: 'vd: 24 lit']
}

// ---------- 7. PRODUCT_VARIANTS ----------
Table product_variants {
  id int [pk, increment]
  product_id int [not null, ref: > products.id]
  sku varchar(50) [unique, not null]
  color_name varchar(100)
  color_code varchar(10) [note: 'Ma mau HEX, vd: #0052cc']
  version_name varchar(100)
  price decimal(15,2) [not null]
  stock int [not null, default: 0]

  Indexes {
    product_id
  }
}

// ---------- 8. VOUCHERS ----------
Table vouchers {
  id int [pk, increment]
  code varchar(50) [unique, not null]
  name varchar(150)
  type voucher_type [not null]
  value decimal(15,2) [not null, note: '% hoac so tien co dinh']
  max_discount decimal(15,2) [note: 'Giam toi da (cho loai %)']
  min_order decimal(15,2) [not null, default: 0, note: 'Don toi thieu']
  usage_limit int
  used_count int [not null, default: 0]
  start_date date
  end_date date
  is_active boolean [not null, default: true]
}

// ---------- 9. BANNERS ----------
Table banners {
  id int [pk, increment]
  title varchar(200)
  subtitle varchar(300)
  badge varchar(50)
  image varchar(255)
  link varchar(255)
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

// ---------- 10. SHOWROOMS ----------
Table showrooms {
  id int [pk, increment]
  name varchar(150) [not null]
  address varchar(255) [not null]
  city varchar(100)
  hotline varchar(30)
  is_active boolean [not null, default: true]
}

// ---------- 11. ORDERS ----------
Table orders {
  id int [pk, increment]
  order_code varchar(30) [unique, not null, note: 'ESF-YYYYMMDD-XXX']
  user_id bigint [ref: > users.id, note: 'NULL neu khach vang lai']
  customer_name varchar(100) [not null]
  customer_email varchar(100)
  customer_phone varchar(20) [not null]
  shipping_address text [not null]
  notes text
  subtotal decimal(15,2) [not null]
  discount_amount decimal(15,2) [not null, default: 0]
  voucher_id int [ref: > vouchers.id]
  voucher_code varchar(50)
  total_amount decimal(15,2) [not null]
  payment_method payment_method [not null]
  payment_status payment_status [not null, default: 'unpaid']
  order_status order_status [not null, default: 'processing']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id
    order_status
    payment_status
    created_at
  }
}

// ---------- 12. ORDER_ITEMS ----------
Table order_items {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  product_id int [ref: > products.id, note: 'NULL neu san pham da bi xoa']
  product_name varchar(150) [not null]
  variant_id int [ref: > product_variants.id]
  variant_name varchar(150)
  price decimal(15,2) [not null]
  quantity int [not null]
  image varchar(255)

  Indexes {
    order_id
  }
}

// ---------- 13. PAYMENTS ----------
Table payments {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  method payment_method [not null]
  amount decimal(15,2) [not null]
  status payment_tx_status [not null, default: 'pending']
  transaction_code varchar(100)
  paid_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    order_id
  }
}

// ---------- 14. CARTS ----------
Table carts {
  id int [pk, increment]
  user_id bigint [ref: > users.id]
  session_id varchar(100) [note: 'Cho khach vang lai']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id
    session_id
  }
}

// ---------- 15. CART_ITEMS ----------
Table cart_items {
  id int [pk, increment]
  cart_id int [not null, ref: > carts.id]
  product_id int [not null, ref: > products.id]
  variant_id int [ref: > product_variants.id]
  quantity int [not null, default: 1]

  Indexes {
    cart_id
    (cart_id, product_id, variant_id) [unique]
  }
}

// ---------- 16. SITE_SETTINGS ----------
Table site_settings {
  id int [pk, increment]
  setting_key varchar(100) [unique, not null]
  setting_value text
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

// ---------- 17. TEST_DRIVE_REQUESTS ----------
Table test_drive_requests {
  id int [pk, increment]
  full_name varchar(100) [not null]
  phone varchar(20) [not null]
  email varchar(100) [not null]
  bike_model varchar(100)
  location varchar(100) [note: 'Showroom gan khach']
  message text
  status tdr_status [not null, default: 'pending']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    status
  }
}

// ============================================================================
// END OF DBML
// ============================================================================
