<IfModule mod_rewrite.c>
    RewriteEngine On

    # Chặn file nhạy cảm
    RewriteRule ^(\.env|\.git|composer\.) - [F,L]

    # Nếu truy cập asset trong public
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Chuyển hướng các request vào public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>
